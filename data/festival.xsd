<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema">

  <!-- ============================================================
       Custom type restrictions are marked with [RESTRICTION] below
       ============================================================ -->

  <!-- [RESTRICTION] ID pattern for venues: V followed by 1-2 digits -->
  <xs:simpleType name="VenueIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="V[0-9]{1,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] ID pattern for performers: P followed by 1-2 digits -->
  <xs:simpleType name="PerformerIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="P[0-9]{1,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] ID pattern for events: E followed by 1-2 digits -->
  <xs:simpleType name="EventIdType">
    <xs:restriction base="xs:string">
      <xs:pattern value="E[0-9]{1,2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] Venue type: only allowed enum values -->
  <xs:simpleType name="VenueTypeEnum">
    <xs:restriction base="xs:string">
      <xs:enumeration value="Outdoor"/>
      <xs:enumeration value="Indoor/Exhibition"/>
      <xs:enumeration value="Indoor"/>
      <xs:enumeration value="Mixed"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] Date must match ISO 8601 format YYYY-MM-DD -->
  <xs:simpleType name="IsoDayType">
    <xs:restriction base="xs:string">
      <xs:pattern value="[0-9]{4}-[0-9]{2}-[0-9]{2}"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] Festival year must be a 4-digit number between 2000 and 2099 -->
  <xs:simpleType name="FestivalYearType">
    <xs:restriction base="xs:integer">
      <xs:minInclusive value="2000"/>
      <xs:maxInclusive value="2099"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- [RESTRICTION] Non-empty string (min length 1) -->
  <xs:simpleType name="NonEmptyString">
    <xs:restriction base="xs:string">
      <xs:minLength value="1"/>
    </xs:restriction>
  </xs:simpleType>

  <!-- Root element -->
  <xs:element name="festival">
    <xs:complexType>
      <xs:sequence>
        <xs:element name="identity" type="IdentityType"/>
        <xs:element name="venues" type="VenuesType"/>
        <xs:element name="performers" type="PerformersType"/>
        <xs:element name="programme" type="ProgrammeType"/>
      </xs:sequence>
      <xs:attribute name="name" type="NonEmptyString" use="required"/>
      <!-- [RESTRICTION] year uses FestivalYearType (2000-2099 range) -->
      <xs:attribute name="year" type="FestivalYearType" use="required"/>
    </xs:complexType>
  </xs:element>

  <xs:complexType name="IdentityType">
    <xs:sequence>
      <xs:element name="location" type="NonEmptyString"/>
      <xs:element name="dates"    type="NonEmptyString"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VenuesType">
    <xs:sequence>
      <xs:element name="venue" type="VenueType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="VenueType">
    <!-- [RESTRICTION] id uses VenueIdType pattern V[0-9]{1,2} -->
    <xs:attribute name="id"   type="VenueIdType"   use="required"/>
    <xs:attribute name="name" type="NonEmptyString" use="required"/>
    <!-- [RESTRICTION] type uses VenueTypeEnum (enumeration) -->
    <xs:attribute name="type" type="VenueTypeEnum"  use="required"/>
  </xs:complexType>

  <xs:complexType name="PerformersType">
    <xs:sequence>
      <xs:element name="performer" type="PerformerType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="PerformerType">
    <xs:simpleContent>
      <xs:extension base="NonEmptyString">
        <!-- [RESTRICTION] id uses PerformerIdType pattern P[0-9]{1,2} -->
        <xs:attribute name="id"        type="PerformerIdType" use="required"/>
        <xs:attribute name="specialty" type="NonEmptyString"  use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

  <xs:complexType name="ProgrammeType">
    <xs:sequence>
      <xs:element name="event" type="EventType" maxOccurs="unbounded"/>
    </xs:sequence>
  </xs:complexType>

  <xs:complexType name="EventType">
    <xs:simpleContent>
      <xs:extension base="NonEmptyString">
        <!-- [RESTRICTION] id uses EventIdType pattern E[0-9]{1,2} -->
        <xs:attribute name="id"        type="EventIdType"     use="required"/>
        <!-- [RESTRICTION] day uses IsoDayType pattern YYYY-MM-DD -->
        <xs:attribute name="day"       type="IsoDayType"      use="required"/>
        <xs:attribute name="venue"     type="VenueIdType"     use="required"/>
        <xs:attribute name="performer" type="PerformerIdType" use="required"/>
      </xs:extension>
    </xs:simpleContent>
  </xs:complexType>

</xs:schema>

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/api/venues/{id}",
  "title": "VenueDetail",
  "type": "object",
  "required": ["id", "name", "type", "events"],
  "properties": {
    "id":   { "type": "string", "pattern": "^V[0-9]+$" },
    "name": { "type": "string" },
    "type": { "type": "string", "enum": ["Outdoor", "Indoor/Exhibition", "Indoor", "Mixed"] },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "day"],
        "properties": {
          "id":    { "type": "string", "pattern": "^E[0-9]+$" },
          "title": { "type": "string" },
          "day":   { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" }
        }
      }
    }
  }
}

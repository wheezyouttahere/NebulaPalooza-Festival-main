{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "/api/events",
  "title": "EventsList",
  "type": "object",
  "required": ["page", "pageSize", "filters", "events"],
  "properties": {
    "page":     { "type": "integer", "minimum": 1 },
    "pageSize": { "type": "integer", "minimum": 1, "maximum": 100 },
    "filters": {
      "type": "object",
      "properties": {
        "day":         { "type": "string" },
        "venueId":     { "type": "string" },
        "performerId": { "type": "string" }
      }
    },
    "events": {
      "type": "array",
      "items": { "$ref": "#/$defs/EventSummary" }
    }
  },
  "$defs": {
    "EventSummary": {
      "type": "object",
      "required": ["id", "title", "day", "venueId", "performerId", "link"],
      "properties": {
        "id":          { "type": "string", "pattern": "^E[0-9]+$" },
        "title":       { "type": "string" },
        "day":         { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "venueId":     { "type": "string", "pattern": "^V[0-9]+$" },
        "performerId": { "type": "string", "pattern": "^P[0-9]+$" },
        "link":        { "type": "string" }
      }
    }
  }
}
